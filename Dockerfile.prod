# ============================================
# Stage 1: Build
# ============================================
FROM ruby:3.2.1 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./

ENV BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1

RUN bundle install --jobs 4

COPY . .

# アセットプリコンパイル（sprockets-rails用、ダミーSECRET_KEY_BASE）
ENV RAILS_ENV=production \
    SECRET_KEY_BASE=dummy_for_precompilation
RUN bundle exec rails assets:precompile

# ============================================
# Stage 2: Runtime
# ============================================
FROM ruby:3.2.1-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libvips42 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 非rootユーザー作成
RUN groupadd --gid 1000 rails && \
    useradd --uid 1000 --gid rails --create-home rails

WORKDIR /app

# Gemとアプリコードをコピー
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app

# tmp/logディレクトリの権限設定
RUN mkdir -p tmp/pids tmp/cache log && \
    chown -R rails:rails tmp log

ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    RAILS_LOG_TO_STDOUT=1

USER rails

EXPOSE 3000

ENTRYPOINT ["bin/docker-entrypoint"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
