<%# Rails の default_url_options を一次ソースにし、テスト/開発環境でも壊れず、 %>
<%# APP_HOST に https:// が混ざっていても二重スキームにならない形で URL を組み立てる %>
<% url_options = Rails.application.config.action_mailer.default_url_options || {} %>
<% host = url_options[:host] || ENV.fetch('APP_HOST', 'localhost:3000') %>
<% protocol = url_options[:protocol] || 'https' %>
<% reset_url = "#{protocol}://#{host}/password/edit?reset_password_token=#{ERB::Util.url_encode(@token)}" %>

<%= t('devise.mailer.reset_password_instructions.greeting', recipient: @resource.email) %>

<%= t('devise.mailer.reset_password_instructions.instruction') %>

<%= reset_url %>

<%= t('devise.mailer.reset_password_instructions.instruction_2') %>
<%= t('devise.mailer.reset_password_instructions.instruction_3') %>
